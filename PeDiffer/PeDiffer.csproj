<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <LangVersion>15</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>

    <PublishAOT>true</PublishAOT>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
  </PropertyGroup>
  <ItemGroup>
    <DirectPInvoke Include="Kernel32" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AsmArm64" Version="2.4.0" />
    <PackageReference Include="Iced" Version="1.22.0" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>
</Project>
